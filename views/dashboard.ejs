<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Home - Blog Project</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container">
      <a class="navbar-brand" href="/">Blog Project</a>
      <div class="navbar-nav ms-auto">
        <% if (isLoggedIn) { %>
          <a class="nav-link" href="/blogs">Blogs</a>
          <a class="nav-link" href="/logout">Logout</a>
        <% } else { %>
          <a class="nav-link" href="/login">Login</a>
          <a class="nav-link" href="/register">Register</a>
        <% } %>
      </div>
    </div>
  </nav>

  <div class="container mt-5">
    <div class="text-center">
      <h1 class="display-4">Welcome to the Blog Project</h1>
      <p class="lead mt-3">
        A simple Node.js application with user authentication using cookies and protected routes.
      </p>
      <hr class="my-4">
      <% if (isLoggedIn) { %>
        <p>You are logged in. <a href="/blogs" class="btn btn-primary">View Blogs</a></p>
      <% } else { %>
        <p>
          <a href="/register" class="btn btn-primary me-2">Register</a>
          <a href="/login" class="btn btn-outline-primary">Login</a>
        </p>
        <p class="text-muted mt-3">Only logged-in users can view the blogs.</p>
      <% } %>
    </div>

    <div class="row mt-5">
      <div class="col-md-4">
        <div class="card h-100">
          <div class="card-body">
            <h5 class="card-title">🔐 Authentication</h5>
            <p class="card-text">Register, Login, and Logout with secure cookie-based authentication and password hashing.</p>
          </div>
        </div>
      </div>
      <div class="col-md-4">
        <div class="card h-100">
          <div class="card-body">
            <h5 class="card-title">🛡️ Protected Routes</h5>
            <p class="card-text">The /blogs page is protected. Only authenticated users can access it via middleware.</p>
          </div>
        </div>
      </div>
      <div class="col-md-4">
        <div class="card h-100">
          <div class="card-body">
            <h5 class="card-title">📖 View Blogs</h5>
            <p class="card-text">Browse available blogs after logging in. Create/Edit/Delete are not included.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</body>
</html>
